<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="P8Maui.Views.NotePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Note">

    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="12">
        <Editor Grid.Row="0"
                Text="{Binding Text}"
                Placeholder="Saisissez votre note..."
                AutoSize="Disabled" />

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Enregistrer" Command="{Binding SaveCommand}" />
            <Button Text="Supprimer"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsExisting}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
