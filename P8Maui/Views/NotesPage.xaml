<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="P8Maui.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Mes notes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ajouter" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <CollectionView ItemsSource="{Binding Notes}"
                        SelectionMode="None"
                        Margin="12">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Text}" Style="{StaticResource NoteTitleLabel}" />
                            <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   Style="{StaticResource NoteDateLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Aucune note pour le moment.&#10;Appuyez sur « Ajouter » pour en créer une."
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="{Binding IsEmpty}" />
    </Grid>
</ContentPage>
